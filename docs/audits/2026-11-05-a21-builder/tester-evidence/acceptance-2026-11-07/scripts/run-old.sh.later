#!/usr/bin/env bash
# Old matrices on the editor-only build (9bc45e69 + 21 files), on the builder's scratch backend (3001), one browser at a
# time, under the shared lock. My own proxy instance (builder's proxy-fail2.mjs, unchanged) on 13171, delay 0;
# matrix25 adds 57 ms latency through CDP as the builder's runs did. r04@0 = my round-04 sequences N,R,V,D,L,K,H.
cd "<session-tmp>/scratchpad/verify-editor"
L=<home>/.claude/ops/heavy-job.lock
until mkdir "$L" 2>/dev/null; do sleep 20; done
printf 'session: Tester(1)\ntaken: %s\npurpose: editor rework acceptance: old matrices on editor-only build (r04@0, win/inject, a24, hash/fine), 1 browser, scratch backend 3001\n' "$(date '+%Y-%m-%d %H:%M:%S')" > "$L/owner.txt"
OUT=<tmp>/edacc/old-matrices; mkdir -p $OUT
node proxy-fail2.mjs <tmp>/edacc/dist-mine 13171 0 > $OUT/proxy.log 2>&1 &
PX=$!
trap 'kill $PX 2>/dev/null; rm -rf "$L"' EXIT
sleep 3
curl -s http://127.0.0.1:13171/ | grep -o 'assets/index-[A-Za-z0-9_-]*\.js' > $OUT/bundle.txt
echo "start $(date -u +%T) bundle $(cat $OUT/bundle.txt)"
node matrix-3001.mjs acc-r04-0 http://localhost:13171 http://127.0.0.1:3001/api local N,R,V,D,L,K,H > $OUT/r04-0.log 2>&1; echo "r04@0 exit $? $(date -u +%T)"; grep SUMMARY $OUT/r04-0.log | cut -c1-400
node matrix25.mjs http://localhost:13171 $OUT/win.json 2 57 '^(win|ctl|inject_)' 3001 > $OUT/win.log 2>&1; echo "win exit $? $(date -u +%T)"; tail -1 $OUT/win.log | cut -c1-600
node matrix25.mjs http://localhost:13171 $OUT/a24.json 2 57 '^(midHash|a24)' 3001 > $OUT/a24.log 2>&1; echo "a24 exit $? $(date -u +%T)"; tail -1 $OUT/a24.log | cut -c1-600
node matrix25.mjs http://localhost:13171 $OUT/hash.json 3 57 '^(hash|fine)' 3001 > $OUT/hash.log 2>&1; echo "hash exit $? $(date -u +%T)"; tail -1 $OUT/hash.log | cut -c1-600
echo "end $(date -u +%T), lock released"
