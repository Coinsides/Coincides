  // Option 4: the transfer reaches the server, and its reply arrives only after the note was left.
  const holdTransferReply = (editor: ReturnType<typeof renderStructure>, reply: 'arrives' | 'fails' | 'never') => {
    const real = editor.transfer.getMockImplementation()!;
    let release!: () => void;
    const gate = new Promise<void>((resolve) => { release = resolve; });
    editor.transfer.mockImplementationOnce(async (input) => {
      const result = await real(input);
      await gate;
      if (reply === 'never') return new Promise<never>(() => {});
      return reply === 'fails' ? null as never : result;
    });
    return release;
  };
  // Three blocks hold a unit called 'title' once the heading has its own block: identity, not the id, must decide.
  const crowded = { more: [textFlow([['m', 'M'], ['title', 'Y']])] };
  const crowdedEnding = textFlow([['end', 'End'], ['title', 'Other']]);
  const leaveDuringTransfer = async (reply: 'arrives' | 'fails' | 'never', noteId = 'note') => {
    const editor = renderStructure(textFlow([['body', 'Intro'], ['title', 'Sec']]), crowdedEnding, {}, { ...crowded, noteId });
    const release = holdTransferReply(editor, reply);
    const { area, typeText } = noteEditor();
    void splitHeading(editor);
    typeText('kept');
    await waitFor(() => expect(editor.transfer).toHaveBeenCalledTimes(1));
    editor.unmount();
    await waitFor(() => expect(typingNotice()).toBeTruthy());
    return { editor, release, area };
  };
  const unitTexts = (blocks: NoteBlock[]) => blocks.map((entry) => [entry.id,
    getTextFlowContent(entry.content_json)!.units.map((unit) => `${unit.id}:${unit.text}`).join('|')]);
  const closeNotices = () => document.querySelectorAll<HTMLButtonElement>('[data-structure-typing-notice] button')
    .forEach((button) => button.click());

  it('option 4: a transfer confirmed after leaving moves the stored words to the new block, and they land there once', async () => {
    const { editor, release, area } = await leaveDuringTransfer('arrives');
    expect(readUnplacedWords('note').map((words) => [words.blockId, words.unitId])).toEqual([['source', 'title']]);
    release();
    await waitFor(() => expect(readUnplacedWords('note').map((words) => [words.blockId, words.unitId, words.text]))
      .toEqual([['new-1', 'title', 'Seckept']]));
    // A key typed into the kept words afterwards stores them where they now belong, not on the old block.
    const box = typingBuffer()!;
    box.value += '!';
    box.dispatchEvent(new Event('input', { bubbles: true }));
    expect(readUnplacedWords('note').map((words) => [words.blockId, words.text])).toEqual([['new-1', 'Seckept!']]);
    const back = renderStructure(textFlow([]), undefined, {}, { blocks: editor.data.blocks });
    await waitFor(() => expect(typingNotice()).toBeNull());
    await waitFor(() => expect(readUnplacedWords('note')).toEqual([]));
    const live = back.data.blocks.map((entry) => [entry.id,
      (back.data.flowDrafts[entry.id] ?? getTextFlowContent(entry.content_json)!).units.map((unit) => `${unit.id}:${unit.text}`).join('|')]);
    expect(live).toEqual([['source', 'body:Intro'], ['ending', 'end:End|title:Other'], ['more-1', 'm:M|title:Y'], ['new-1', 'title:Seckept!']]);
    back.unmount();
    area.remove();
  });

  it.each(['fails', 'never'] as const)('option 4: when the transfer reply %s, the words stay kept on the old block and are not written', async (reply) => {
    const { editor, release, area } = await leaveDuringTransfer(reply);
    release();
    await act(async () => { await new Promise((resolve) => setTimeout(resolve, 100)); });
    expect(readUnplacedWords('note').map((words) => [words.blockId, words.unitId])).toEqual([['source', 'title']]);
    const before = unitTexts(editor.data.blocks);
    const back = renderStructure(textFlow([]), undefined, {}, { blocks: editor.data.blocks });
    await act(async () => { await new Promise((resolve) => setTimeout(resolve, 200)); });
    expect(typingNotice()).toBeTruthy();
    expect(back.save).not.toHaveBeenCalled();
    expect(unitTexts(back.data.blocks)).toEqual(before);
    expect(readUnplacedWords('note').map((words) => words.text)).toEqual(['Seckept']);
    back.unmount();
    closeNotices();
    localStorage.clear();
    area.remove();
  });

  it('option 4: a reply for note A arriving while note B is open changes nothing of B', async () => {
    const { release, area } = await leaveDuringTransfer('arrives', 'note-a');
    const other = renderStructure(textFlow([['body', 'B1'], ['title', 'B2']]), crowdedEnding, {}, { ...crowded, noteId: 'note-b' });
    await act(async () => { await new Promise((resolve) => setTimeout(resolve, 50)); });
    const blocksBefore = structuredClone(other.data.blocks);
    release();
    await waitFor(() => expect(readUnplacedWords('note-a').map((words) => words.blockId)).toEqual(['new-1']));
    await act(async () => { await new Promise((resolve) => setTimeout(resolve, 100)); });
    expect(other.data.blocks).toEqual(blocksBefore);
    expect(other.data.flowDrafts).toEqual({});
    expect(other.save).not.toHaveBeenCalled();
    expect(other.transfer).not.toHaveBeenCalled();
    expect(other.create).not.toHaveBeenCalled();
    expect(typingBuffer()?.dataset.structureTypingBuffer).toBe('true');
    expect(readUnplacedWords('note-b')).toEqual([]);
    other.unmount();
    closeNotices();
    localStorage.clear();
    area.remove();
  });
});
