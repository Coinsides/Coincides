{
  "name": "coincides-client",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "check:canvas-runtime-boundary": "node scripts/canvasRuntimeBoundaryCheck.mjs",
    "check:group-gallery-shell": "node scripts/groupGalleryShellContractCheck.mjs",
    "check:single-editor-shell": "node scripts/singleEditorShellContractCheck.mjs",
    "check:groups-rail-shell": "node scripts/groupsRailShellContractCheck.mjs",
    "check:v2-bn11-legacy-shutdown": "node scripts/v2Bn11LegacyShutdownContractCheck.mjs",
    "check:v2-bn11-relation-freshness": "node scripts/v2Bn11RelationFreshnessContractCheck.mjs",
    "check:source-experience": "node scripts/sourceExperienceContractCheck.mjs && tsc -p scripts/tsconfig.source-experience.json && node ../.codex-tmp/source-experience/client/scripts/sourceExperienceModelContractCheck.js",
    "smoke:canvas-engine-model-contract": "tsc -p scripts/tsconfig.canvas-model-contract.json && node ../.codex-tmp/canvas-engine-contract/client/scripts/canvasEngineModelContractCheck.js",
    "smoke:canvas-engine-performance": "tsc -p scripts/tsconfig.canvas-performance.json && node ../.codex-tmp/canvas-engine-performance/scripts/canvasEnginePerformanceSeed.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/katex": "^0.16.8",
    "axios": "^1.7.0",
    "date-fns": "^3.6.0",
    "i18next": "^25.8.18",
    "katex": "^0.16.38",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^6.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "15.0.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "26.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "3.2.7"
  }
}
