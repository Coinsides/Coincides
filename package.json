{
  "name": "coincides",
  "version": "1.8.0",
  "private": true,
  "description": "Coincides — AI-Powered Learning System for STEM Students",
  "author": "Coincides",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:all": "npm run dev:server & npm run dev:client",
    "build": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "test:unit": "cd client && npm run test:unit",
    "check:canvas-runtime-boundary": "cd client && npm run check:canvas-runtime-boundary",
    "check:group-gallery-shell": "cd client && npm run check:group-gallery-shell",
    "check:single-editor-shell": "cd client && npm run check:single-editor-shell",
    "check:groups-rail-shell": "cd client && npm run check:groups-rail-shell",
    "check:v2-bn11-legacy-shutdown": "cd client && npm run check:v2-bn11-legacy-shutdown",
    "check:v2-bn11-relation-freshness": "cd client && npm run check:v2-bn11-relation-freshness",
    "check:source-experience": "cd client && npm run check:source-experience",
    "check:changed-file-secrets": "node scripts/changedFileSecretScan.mjs",
    "fixtures:source-smoke": "cd server && node scripts/generateSourceSmokeFixtures.mjs",
    "smoke:canvas-engine-model-contract": "cd client && npm run smoke:canvas-engine-model-contract",
    "smoke:canvas-engine-performance": "cd client && npm run smoke:canvas-engine-performance",
    "verify:v2-bn8-runtime": "npm run check:canvas-runtime-boundary && npm run check:v2-bn11-relation-freshness && npm run smoke:canvas-engine-model-contract && npm run build:client && npm run build && npm run smoke:canvas-engine-performance && git diff --check && npm run check:changed-file-secrets",
    "start": "cd server && npm run start",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "setup": "npm run install:all"
  }
}
